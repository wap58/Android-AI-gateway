<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 的包可见性：不声明 queries 时 queryIntentActivities 只能看到自己。
      登录页要让用户选浏览器（多账号用不同浏览器隔离 Cookie），必须能看到本机浏览器。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <!-- 可选的悬浮窗保活：在屏幕上留一个小窗，降低后台被系统回收的概率 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 应用内更新：下载 APK 后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".AiGatewayApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.AiGateway">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内嵌网页登录：没有 OAuth 回调的上游（WPS 灵犀）在这里登录后抓 cookie -->


        <activity
            android:name=".ui.login.WebCookieLoginActivity"
            android:exported="false"
            android:label="登录"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.GatewayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本地网关需在后台持续监听端口，锁屏后客户端仍能调用" />
        </service>


        <!--
          备用通道：把应用私有目录里的文件以 content:// 交给外部应用。

          当前的应用内更新**不走它** —— 下载交给系统 DownloadManager，落地在公共
          Download/TYD，再用 getUriForDownloadedFile() 拿系统托管的 content:// URI
          交给安装器（这样 App 被杀也能继续下载，也不用暴露自己的目录）。
          保留声明是为了将来需要从私有目录导出文件时有现成的 provider；
          authorities 用 ${applicationId}，debug 包才不会因包名后缀对不上而崩。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>



        <!--
          空壳无障碍服务：只借「已启用无障碍」这个身份换后台优先级，
          不读取窗口内容（canRetrieveWindowContent=false）。
          用户可在系统设置一览里看到它并随时关闭。
        -->
        <service
            android:name=".service.KeepAliveAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keepalive_accessibility" />
        </service>
        <service
            android:name=".service.GatewayTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_gateway"
            android:label="网关"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 开机自启：开关开启时，系统启动完成后自动拉起网关服务 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
